{
  "name": "netverse-3d",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev -w @netverse/web",
    "dev:api": "npm run dev -w @netverse/api",
    "dev:game": "npm run dev -w @netverse/game-server",
    "lint": "npm run lint -w @netverse/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": { "node": ">=22" }
}
